.sprite-editor-split-handle {
    --split-line: rgb(18, 18, 18);
    --split-border: rgb(55, 55, 55);
    --split-grip: rgb(160, 160, 160);
}

.sprite-editor-split-handle--light {
    --split-line: rgb(82, 82, 82);
    --split-border: rgb(176, 176, 176);
    --split-grip: rgb(210, 210, 210);
}

.sprite-editor-split-handle--columns {
    width: 5px;
    height: 100%;
    cursor: resize-horizontal;
}

.sprite-editor-split-handle--rows {
    width: 100%;
    height: 5px;
    cursor: resize-vertical;
}

.sprite-editor-split-handle > .sprite-editor-split-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    height: auto;
    margin: 0;
    background-color: var(--split-line);
    border-color: var(--split-border);
    align-items: center;
    justify-content: center;
}

.sprite-editor-split-handle--columns > .sprite-editor-split-line {
    border-left-width: 1px;
    border-right-width: 1px;
}

.sprite-editor-split-handle--rows > .sprite-editor-split-line {
    border-top-width: 1px;
    border-bottom-width: 1px;
    flex-direction: row;
}

.sprite-editor-split-line > .sprite-editor-split-grip {
    width: 2px;
    height: 2px;
    flex-shrink: 0;
    margin: 2px;
    border-radius: 1px;
    background-color: var(--split-grip);
}

.sprite-editor-split-handle--columns > .sprite-editor-split-line > .sprite-editor-split-grip {
    margin-left: 0;
    margin-right: 0;
}

.sprite-editor-split-handle--rows > .sprite-editor-split-line > .sprite-editor-split-grip {
    margin-top: 0;
    margin-bottom: 0;
}

.sprite-editor-split-handle:hover > .sprite-editor-split-line {
    border-color: rgb(59, 105, 151);
}

.sprite-editor-split-handle:active > .sprite-editor-split-line {
    border-color: rgb(43, 128, 213);
}

.sprite-editor-split-handle:hover > .sprite-editor-split-line > .sprite-editor-split-grip,
.sprite-editor-split-handle:active > .sprite-editor-split-line > .sprite-editor-split-grip {
    background-color: rgb(239, 246, 255);
}
