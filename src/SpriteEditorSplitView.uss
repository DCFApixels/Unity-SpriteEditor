.unity-button.sprite-editor-layer-menu-button {
    --menu-hover: rgba(255, 255, 255, 0.12);
    --menu-pressed: rgba(255, 255, 255, 0.2);
    --menu-dot: #d2d2d2;
    flex-direction: column;
    width: 18px;
    min-width: 0;
    height: 22px;
    flex-shrink: 0;
    margin: 0 0 0 2px;
    padding: 0;
    border-width: 0;
    border-radius: 2px;
    background-image: none;
    background-color: transparent;
    align-items: center;
    justify-content: center;
}

.unity-button.sprite-editor-layer-menu-button--light {
    --menu-hover: rgba(0, 0, 0, 0.1);
    --menu-pressed: rgba(0, 0, 0, 0.18);
    --menu-dot: #333333;
}

.unity-button.sprite-editor-layer-menu-button:hover {
    background-color: var(--menu-hover);
}

.unity-button.sprite-editor-layer-menu-button:active {
    background-color: var(--menu-pressed);
}

.sprite-editor-layer-menu-dot {
    width: 2px;
    height: 2px;
    flex-shrink: 0;
    margin-top: 1px;
    margin-bottom: 1px;
    border-radius: 1px;
    background-color: var(--menu-dot);
}

.sprite-editor-canvas-toolbar {
    flex-shrink: 0;
}

.sprite-editor-workspace {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.sprite-editor-tools {
    width: 36px;
    flex-shrink: 0;
    align-items: center;
    padding-top: 4px;
    background-color: #383838;
    border-right-width: 1px;
    border-right-color: #171717;
}

.sprite-editor-workspace-split {
    flex-basis: 0;
    min-width: 0;
}

.sprite-editor-tools--light {
    background-color: #c4c4c4;
    border-right-color: #858585;
}

.unity-button.sprite-editor-tool-button {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin: 0 0 3px 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-image: none;
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    border-radius: 3px;
    color: #d2d2d2;
}

.sprite-editor-tools--light > .unity-button.sprite-editor-tool-button {
    color: #333333;
}

.unity-button.sprite-editor-tool-button:hover {
    background-color: rgba(128, 128, 128, 0.25);
}

.unity-button.sprite-editor-tool-button--selected,
.unity-button.sprite-editor-tool-button--selected:hover {
    background-color: #2e619e;
    border-color: #578ac0;
}

.sprite-editor-tools > .unity-button.sprite-editor-tool-button--selected {
    color: #eeeeee;
}

.unity-button.sprite-editor-tool-button:active {
    background-color: #254e7e;
}

.unity-button.sprite-editor-tool-button:focus {
    border-color: #578ac0;
}

.unity-button.sprite-editor-tool-button:disabled {
    opacity: 0.4;
}

.sprite-editor-tool-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
}

.sprite-editor-tool-options--hidden {
    display: none;
}

.sprite-editor-fill-settings {
    flex-wrap: wrap;
    flex-shrink: 0;
}

.sprite-editor-fill-settings > * {
    flex-shrink: 0;
    margin: 1px 3px;
    height: 22px;
}

.sprite-editor-fill-settings > .unity-base-field {
    align-items: center;
}

.sprite-editor-fill-tolerance {
    width: 184px;
}

.sprite-editor-fill-expand {
    width: 156px;
}

.sprite-editor-fill-settings > .unity-base-field > .unity-base-field__label {
    min-width: 0;
    width: auto;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: stretch;
    margin: 0 6px 0 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.sprite-editor-fill-settings > .unity-toggle > .unity-base-field__input {
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0;
}

.sprite-editor-saved-output-preview {
    height: 160px;
    flex-shrink: 0;
    margin-top: 4px;
    margin-bottom: 6px;
}

.sprite-editor-saved-output-preview--empty {
    display: none;
}

.sprite-editor-transform-settings {
    flex-wrap: wrap;
    flex-shrink: 0;
}

.sprite-editor-transform-option,
.sprite-editor-transform-settings > .unity-button {
    flex-shrink: 0;
    min-height: 24px;
}

.sprite-editor-preview-actions {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-end;
    margin-left: 4px;
}

.sprite-editor-canvas-title {
    -unity-font-style: bold;
    flex-shrink: 0;
    margin-right: 6px;
}

.sprite-editor-canvas-size {
    flex-basis: 98px;
    min-width: 60px;
    flex-shrink: 1;
}

.sprite-editor-canvas-size > .unity-base-field__label {
    width: 22px;
    min-width: 22px;
    flex-shrink: 0;
}

.sprite-editor-layer-row {
    --layer-row-background: #2e2e2e;
    --layer-row-selected: #2e4766;
    --layer-row-active: #2e619e;
    --layer-row-outline: #4377b0;
    background-color: var(--layer-row-background);
}

.sprite-editor-layer-row--light {
    --layer-row-background: #d1d1d1;
    --layer-row-selected: #99b8d9;
    --layer-row-active: #619ee0;
    --layer-row-outline: #78afe8;
}

.sprite-editor-layer-row--selected {
    background-color: var(--layer-row-selected);
}

.sprite-editor-layer-row--active {
    background-color: var(--layer-row-active);
}

.sprite-editor-layer-active-outline {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-width: 1px;
    border-color: var(--layer-row-outline);
    border-radius: 2px;
}

.sprite-editor-layer-row--active > .sprite-editor-layer-active-outline {
    display: flex;
}

.sprite-editor-layers-pane {
    min-height: 100px;
}

.sprite-editor-layers-footer {
    --footer-button: #383838;
    --footer-divider: #121212;
    --footer-hover: #4c4c4c;
    --footer-pressed: #5c5c5c;
    height: 26px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-left: 4px;
    padding-right: 4px;
    background-color: #292929;
    border-top-width: 1px;
    border-top-color: #121212;
}

.sprite-editor-layers-footer--light {
    --footer-button: #c2c2c2;
    --footer-divider: #525252;
    --footer-hover: #b2b2b2;
    --footer-pressed: #a3a3a3;
    background-color: #adadad;
    border-top-color: #525252;
}

.sprite-editor-layers-footer > .sprite-editor-layer-action {
    width: 24px;
    height: 24px;
    min-width: 0;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-image: none;
    background-color: var(--footer-button);
    align-items: center;
    justify-content: center;
}

.sprite-editor-layers-footer > .sprite-editor-layer-action--separated {
    border-left-width: 1px;
    border-left-color: var(--footer-divider);
}

.sprite-editor-layers-footer > .sprite-editor-layer-action:hover {
    background-color: var(--footer-hover);
}

.sprite-editor-layers-footer > .sprite-editor-layer-action:active {
    background-color: var(--footer-pressed);
}

.sprite-editor-layers-footer > .sprite-editor-layer-action:disabled {
    background-color: var(--footer-button);
}

.sprite-editor-layers-footer > .sprite-editor-layer-action.sprite-editor-layer-action--drop-target {
    background-color: #3b6997;
}

.sprite-editor-layer-action-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.sprite-editor-layer-action:disabled > .sprite-editor-layer-action-icon {
    opacity: 0.35;
}

.sprite-editor-settings-pane,
.sprite-editor-document-header {
    background-color: #383838;
}

.sprite-editor-settings-pane--light,
.sprite-editor-document-header--light {
    background-color: #c2c2c2;
}

.sprite-editor-document-header {
    border-bottom-width: 0;
}

.sprite-editor-pane-header {
    height: 24px;
    flex-shrink: 0;
    margin: 0;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-left;
    background-color: #454545;
    color: #cfcfcf;
    border-bottom-width: 1px;
    border-bottom-color: #171717;
    overflow: hidden;
    text-overflow: ellipsis;
}

.sprite-editor-pane-header--light {
    background-color: #d0d0d0;
    color: #252525;
    border-bottom-color: #858585;
}

.sprite-editor-layer-settings-pane {
    min-height: 100px;
    flex-grow: 1;
}

.sprite-editor-layer-settings-pane > .unity-scroll-view {
    min-height: 0;
    flex-grow: 1;
}

.sprite-editor-effect-target--drop > .unity-base-field__input {
    border-width: 1px;
    border-color: #5688b8;
    background-color: #315c85;
}

.sprite-editor-document-separator {
    height: 3px;
    flex-shrink: 0;
    background-color: var(--split-line);
}

.sprite-editor-split-handle,
.sprite-editor-document-separator {
    overflow: visible;
    --split-line: rgb(18, 18, 18);
    --split-grip: rgb(160, 160, 160);
}

.sprite-editor-split-handle--light,
.sprite-editor-document-separator--light {
    --split-line: rgb(82, 82, 82);
    --split-grip: rgb(210, 210, 210);
}

.sprite-editor-split-handle--columns {
    width: 3px;
    height: 100%;
    cursor: resize-horizontal;
}

.sprite-editor-split-handle--rows {
    width: 100%;
    height: 3px;
    cursor: resize-vertical;
}

.sprite-editor-split-hit-area {
    position: absolute;
}

.sprite-editor-split-handle--columns > .sprite-editor-split-hit-area {
    left: -1px;
    right: -1px;
    top: 0;
    bottom: 0;
    cursor: resize-horizontal;
}

.sprite-editor-split-handle--rows > .sprite-editor-split-hit-area {
    left: 0;
    right: 0;
    top: -1px;
    bottom: -1px;
    cursor: resize-vertical;
}

.sprite-editor-split-handle > .sprite-editor-split-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    height: auto;
    margin: 0;
    background-color: var(--split-line);
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.sprite-editor-split-handle--rows > .sprite-editor-split-line {
    flex-direction: row;
}

.sprite-editor-split-line > .sprite-editor-split-grip {
    width: 2px;
    height: 2px;
    flex-shrink: 0;
    margin: 2px;
    border-radius: 1px;
    background-color: var(--split-grip);
}

.sprite-editor-split-handle--columns > .sprite-editor-split-line > .sprite-editor-split-grip {
    margin-left: 0;
    margin-right: 0;
}

.sprite-editor-split-handle--rows > .sprite-editor-split-line > .sprite-editor-split-grip {
    margin-top: 0;
    margin-bottom: 0;
}

.sprite-editor-split-handle:hover > .sprite-editor-split-line {
    background-color: #3b6997;
}

.sprite-editor-split-handle:hover > .sprite-editor-split-line > .sprite-editor-split-grip,
.sprite-editor-split-handle:active > .sprite-editor-split-line > .sprite-editor-split-grip {
    background-color: rgb(239, 246, 255);
}

.sprite-editor-shader-fx {
    padding: 4px;
}

.sprite-editor-shader-fx-heading {
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 4px;
}

.sprite-editor-shader-fx-code {
    height: 320px;
    flex-shrink: 0;
}

.sprite-editor-shader-fx-code .unity-text-field__input {
    -unity-text-align: upper-left;
    white-space: normal;
}

.sprite-editor-shader-fx-diagnostics {
    min-height: 48px;
    max-height: 180px;
    margin-top: 4px;
}

.sprite-editor-shader-fx-parameter {
    padding: 4px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.3);
}

.sprite-editor-shader-fx-hidden {
    display: none;
}

.sprite-editor-modifier-buttons {
    flex-wrap: wrap;
}

.sprite-editor-layer-fx {
    margin-top: 8px;
}

.sprite-editor-layer-fx-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.sprite-editor-layer-fx-name {
    flex-grow: 1;
    min-width: 60px;
}

.sprite-editor-layer-fx-entry {
    margin-top: 6px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.3);
}

.sprite-editor-pattern-field--hidden {
    display: none;
}

.sprite-editor-preview-footer {
    flex-direction: row;
    align-items: center;
    height: 22px;
    flex-shrink: 0;
    padding-left: 4px;
    padding-right: 4px;
}

.sprite-editor-preview-status {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-center;
    font-size: 10px;
}

.sprite-editor-preview-quality {
    flex-direction: row;
    align-items: center;
    width: 170px;
    height: 22px;
    flex-shrink: 0;
}

.sprite-editor-preview-quality-label {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    font-size: 10px;
}

.sprite-editor-preview-quality-slider {
    flex-grow: 1;
    min-width: 40px;
    margin: 0 4px;
}

.sprite-editor-preview-quality-value {
    width: 34px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    font-size: 10px;
    -unity-text-align: middle-right;
}

.sprite-editor-preview-channels {
    flex-direction: row;
    flex-shrink: 0;
    margin-left: auto;
    height: 22px;
    align-items: center;
}

.sprite-editor-preview-footer--compact {
    height: auto;
    min-height: 22px;
    flex-wrap: wrap;
}

.sprite-editor-preview-footer--compact .sprite-editor-preview-status {
    display: none;
}

.unity-button.sprite-editor-channel-button {
    --channel-fill: #6a6a6e;
    --channel-hover: #79797d;
    --channel-text: #eeeeef;
    --channel-border: #939397;
    width: 24px;
    height: 18px;
    flex-shrink: 0;
    margin: 0 0 0 2px;
    padding: 1px 0 0 0;
    background-image: none;
    background-color: #252527;
    color: #a2a2a6;
    border-width: 1px;
    border-top-color: #111113;
    border-left-color: #19191b;
    border-right-color: #424246;
    border-bottom-color: #56565a;
    border-radius: 2px;
    font-size: 10px;
}

.unity-button.sprite-editor-channel-button:hover {
    background-color: #2e2e31;
}

.unity-button.sprite-editor-channel-button--enabled {
    padding: 0;
    background-color: var(--channel-fill);
    color: var(--channel-text);
    border-color: var(--channel-border);
}

.unity-button.sprite-editor-channel-button--enabled:hover {
    background-color: var(--channel-hover);
}

.unity-button.sprite-editor-channel-button--r {
    --channel-fill: #92555d;
    --channel-hover: #a2646c;
    --channel-text: #ead9d9;
    --channel-border: #b77981;
}

.unity-button.sprite-editor-channel-button--g {
    --channel-fill: #487c59;
    --channel-hover: #578b68;
    --channel-text: #dce8df;
    --channel-border: #6ba27e;
}

.unity-button.sprite-editor-channel-button--b {
    --channel-fill: #4b70a0;
    --channel-hover: #5a7faf;
    --channel-text: #dce3ed;
    --channel-border: #7298c5;
}
